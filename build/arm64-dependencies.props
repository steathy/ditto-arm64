<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DittoZlibRoot Condition="'$(DittoZlibRoot)'==''">$(MSBuildThisFileDirectory)..\work\dependencies\installed\arm64\$(Configuration)\</DittoZlibRoot>
    <DittoZlibLibrary>$(DittoZlibRoot)lib\zs.lib</DittoZlibLibrary>
    <DittoZlibLibrary Condition="'$(Configuration)'=='Debug'">$(DittoZlibRoot)lib\zsd.lib</DittoZlibLibrary>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DittoZlibRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DittoZlibLibrary);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CheckArm64Zlib" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PreferredToolArchitecture)'=='x86'" Text="The ARM64 build needs a 64-bit MSBuild/compiler host for its precompiled header. Use tools\arm64\Build-Arm64.ps1, or the ARM64/x64 MSBuild executable." />
    <Error Condition="!Exists('$(DittoZlibRoot)include\zlib.h') Or !Exists('$(DittoZlibLibrary)')" Text="ARM64 zlib is missing. Run powershell -NoProfile -ExecutionPolicy Bypass -File tools\arm64\Build-Arm64.ps1 -Configuration $(Configuration) to restore and build the pinned dependency." />
  </Target>
</Project>
